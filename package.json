{
  "name": "gully-voice-agent",
  "version": "0.1.0",
  "description": "Modular Sarvam AI + LiveKit voice agents for Galynest automated outbound calls",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "preconsole:worker": "npm run build",
    "preconsole:text": "npm run build",
    "predaemon:start": "npm run build",
    "dev:worker": "tsx src/workers/property-availability.worker.ts dev",
    "start:worker": "tsx src/workers/property-availability.worker.ts start",
    "console:worker": "lk agent console dist/workers/property-availability.worker.js",
    "console:text": "lk agent console dist/workers/property-availability.worker.js --text",
    "daemon:start": "lk agent daemon start dist/workers/property-availability.worker.js",
    "daemon:say": "lk agent daemon say",
    "daemon:stop": "lk agent daemon stop",
    "dev:api": "tsx src/api/server.ts",
    "trigger:call": "tsx src/scripts/trigger-call.ts",
    "cron:voice": "tsx src/scripts/run-voice-cron.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/apply-migrations.ts",
    "db:purge-expired": "tsx src/scripts/purge-expired-call-data.ts",
    "db:push": "drizzle-kit push",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:console:text": "npm run console:text",
    "test:console:voice": "npm run console:worker",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@livekit/agents": "^1.5.1",
    "@livekit/agents-plugin-elevenlabs": "^1.5.1",
    "@livekit/agents-plugin-openai": "^1.5.1",
    "@livekit/agents-plugin-sarvam": "^1.5.1",
    "@livekit/rtc-node": "^0.13.31",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.1",
    "livekit-server-sdk": "^2.15.0",
    "postgres": "^3.4.9",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
