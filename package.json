{
  "name": "gully-voice-agent",
  "version": "0.1.0",
  "description": "Modular Sarvam AI + LiveKit voice agents for Gullynest automated outbound calls",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev:worker": "tsx src/workers/property-availability.worker.ts dev",
    "start:worker": "tsx src/workers/property-availability.worker.ts start",
    "console:worker": "tsx src/workers/property-availability.worker.ts console",
    "dev:api": "tsx src/api/server.ts",
    "trigger:call": "tsx src/scripts/trigger-call.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@livekit/agents": "^1.5.0",
    "@livekit/agents-plugin-openai": "^1.5.0",
    "@livekit/agents-plugin-sarvam": "^1.5.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "livekit-server-sdk": "^2.15.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
