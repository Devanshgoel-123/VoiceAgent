# LiveKit (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sarvam AI (https://dashboard.sarvam.ai)
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx

# Speech provider: sarvam | elevenlabs
# Sarvam always remains the STT + LLM provider; this switches TTS only.
TTS_PROVIDER=sarvam

# Required only when TTS_PROVIDER=elevenlabs
ELEVEN_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: choose a voice from https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=
# v3 supports English + Hindi + Kannada and is the most expressive.
# If you only need English/Hindi and prioritize latency: eleven_flash_v2_5
ELEVENLABS_MODEL=eleven_flash_v2_5
# HTTP is reliable with all models. WebSocket is lower-latency, but plugin 1.5.1
# may not receive the final marker from ElevenLabs' multi-context stream.
ELEVENLABS_TRANSPORT=http

# Telephony — outbound SIP trunk ID from LiveKit dashboard
SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxxxxxx

# Postgres for call logs (Drizzle). Optional locally — JSON files still written on worker disk.
# Placeholder only — never commit real credentials. Rotate any credential ever checked into git.
DATABASE_URL=postgresql://user:password@host.example/dbname?sslmode=require

# API authentication (required for the HTTP server)
API_SECRET_KEY=change-me-to-a-long-random-secret

# Dispatch dedupe: minimum ms between calls to the same property+phone (default 86400000 = 24h)
DISPATCH_COOLDOWN_MS=86400000
# Quiet hours window in local wall-clock for CALLING_HOURS_TZ (default India)
CALLING_HOURS_START_HOUR=9
CALLING_HOURS_END_HOUR=20
CALLING_HOURS_TZ=Asia/Kolkata

# Logging: production suppresses verbose transcript lines unless CALL_DEBUG_LOGGING=true
APP_ENV=developer
CALL_DEBUG_LOGGING=
# Verbatim transcripts are stored in Postgres only (never in call_results JSON).
# After this many days, transcript jsonb is cleared (outcome/summary kept). Default 15.
CALL_DATA_RETENTION_DAYS=15
# Agent dispatch name (must match worker registration)
AGENT_NAME=gully-property-availability-agent

# API server
API_HOST=0.0.0.0
API_PORT=8080

# Company branding (single source of truth for all scripted messages)
COMPANY_NAME=Galynest
COMPANY_WEBSITE=galynest.com
# Human name spoken in the opening introduction
CALLER_NAME=Aditi

# Agent voice loudness (0.1–1.0)
TTS_VOLUME=0.55
# Speaking speed (1.0 = normal). ElevenLabs min 0.8; Sarvam min 0.5
TTS_SPEED=0.8

# Optional tuning (defaults shown)
LLM_MODEL=sarvam-105b
DEFAULT_LANGUAGE=en-IN
TELEPHONY_SAMPLE_RATE=8000
